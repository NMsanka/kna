      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 40,
      "y": 2080,
      "width": 2000,
      "height": 100,
      "fontSize": 13,
      "fontFamily": 5,
      "text": "The sweep compares chunk and symbol ids against what this run just wrote — never commit shas. Comparing shas is right for a new commit and\nsilently wrong for the two cases that reindex the same one: a deliberate /v1/admin/reindex, and a crashed run retried. Stale rows carried the\nmatching sha, survived, and the corpus held two versions of the same code at once.",
      "originalText": "The sweep compares chunk and symbol ids against what this run just wrote — never commit shas. Comparing shas is right for a new commit and\nsilently wrong for the two cases that reindex the same one: a deliberate /v1/admin/reindex, and a crashed run retried. Stale rows carried the\nmatching sha, survived, and the corpus held two versions of the same code at once.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 10
    },
