      "type": "text",
      "x": 40,
      "y": 3550,
      "width": 1080,
      "height": 80,
      "fontSize": 13,
      "fontFamily": 5,
      "text": "The in-repo copy is the half of the exit plan that survives the platform\nbeing switched off. Generated docs land as a pull request, and a human\nagrees to them.",
      "originalText": "The in-repo copy is the half of the exit plan that survives the platform\nbeing switched off. Generated docs land as a pull request, and a human\nagrees to them.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 10
    },
