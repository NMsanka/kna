{
  "name": "@kna/retrieval",
  "version": "1.0.0",
  "description": "Hybrid retrieval: dense + BM25 + symbol, RRF, rerank, graph expansion",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kna/chunking": "workspace:*",
    "@kna/config": "workspace:*",
    "@kna/db": "workspace:*",
    "@kna/ir": "workspace:*",
    "@kna/llm": "workspace:*",
    "@kna/observability": "workspace:*",
    "drizzle-orm": "^0.45.2"
  }
}
