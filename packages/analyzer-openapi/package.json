{
  "name": "@kna/analyzer-openapi",
  "version": "1.0.0",
  "description": "Tier 2 OpenAPI, IaC and service-manifest extraction",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
