{
  "name": "@kna/analyzer-typescript",
  "version": "1.0.0",
  "description": "Tier 1 TypeScript/JavaScript analyser (ts-morph)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kna/ir": "workspace:*",
    "@kna/analyzer-core": "workspace:*",
    "ts-morph": "^24.0.0"
  }
}
