# Template for .env. Copy it:  cp .env.example .env
#
# The real file is gitignored. Loaded automatically by loadPlatformEnv() — the real environment always wins over
# this file, and production refuses to read it at all (see packages/config/src/dotenv.ts).
#
# The values below are the ones verified working against the local docker-compose stack. The
# only things you need to supply yourself are marked "SET THIS".
#
# Start here:
#   docker compose -f deploy/docker-compose.yml up -d postgres redis
#   pnpm db:migrate
#   node apps/api/dist/server.js
#
# Every service starts with no LLM provider configured. What needs one is search (embeddings)
# and indexing (embeddings + context blurbs).

KNA_ENV=development
KNA_REGION=local
LOG_LEVEL=info

# ── Datastores ────────────────────────────────────────────────────────────────────────────────
# Application roles, never the owner `kna`. A superuser bypasses row-level security *silently*:
# policies exist, the invariant check passes, and every tenant reads every other tenant with
# nothing erroring. assertRlsEffective() refuses to start against one.
#
# Set the passwords once, after migrating:
#   docker exec kna-postgres-1 psql -U kna -d kna \
#     -c "ALTER ROLE kna_interactive WITH PASSWORD 'devpass'; ALTER ROLE kna_batch WITH PASSWORD 'devpass';"
DATABASE_URL=postgres://kna_interactive:devpass@localhost:5432/kna
DATABASE_URL_BATCH=postgres://kna_batch:devpass@localhost:5432/kna
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Indexing holds a transaction-scoped module lock across provider calls. Zero disables the
# idle-in-transaction timeout for batch connections; interactive connections remain protected.
DATABASE_BATCH_IDLE_IN_TRANSACTION_TIMEOUT_MS=0

REDIS_URL=redis://localhost:6379

# ── Object storage: the system of record (§15.1) ──────────────────────────────────────────────
# Needs MinIO: docker compose -f deploy/docker-compose.yml up -d minio minio-init
# Without it, readiness reports `bundle-store: degraded` and stays `ok` — it is advisory. What
# actually breaks is ingest, which must durably store a bundle before anything derived happens.
BUNDLE_STORE_ENDPOINT=http://localhost:9000
BUNDLE_STORE_BUCKET=kna-ir-bundles
BUNDLE_STORE_ACCESS_KEY=kna
BUNDLE_STORE_SECRET_KEY=knaknakna
BUNDLE_STORE_REGION=us-east-1
AUDIT_STORE_BUCKET=kna-audit

# ── LLM routing ───────────────────────────────────────────────────────────────────────────────
# Everything goes through the LiteLLM proxy, never a provider SDK directly (§11).
#   docker compose -f deploy/docker-compose.yml up -d litellm
#
# SET THIS to use search or indexing. The proxy reads OPENAI_API_KEY from its own environment,
# so put your key here and docker-compose passes it through.
OPENAI_API_KEY=

LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-kna-master

# Separate virtual keys, so a backfill cannot 429 the chat path (§15.6). Both point at the
# master key locally; in a real deployment they are distinct keys with distinct rate limits.
LITELLM_KEY_INTERACTIVE=sk-kna-master
LITELLM_KEY_BATCH=sk-kna-master

# Authentication used when KNA calls LITELLM_BASE_URL. These defaults work with OpenAI and a
# standard LiteLLM proxy. Any OpenAI-compatible gateway can be used directly: set its required
# header name and choose `raw` when the key must not be prefixed with `Bearer `.
LITELLM_AUTH_HEADER=authorization
LITELLM_AUTH_SCHEME=bearer

EMBEDDING_MODEL=text-embedding-3-large
# §11's dimension trap: pgvector's HNSW index caps at 2,000 dimensions for the `vector` type and
# this model returns 3,072 natively. These models are Matryoshka-trained, so truncating to 1024
# is graceful and halves index RAM. loadPlatformEnv() refuses anything above 2000.
EMBEDDING_DIMENSIONS=1024

# These name **routes on the LiteLLM proxy**, not provider model ids — see the `model_name`
# entries in deploy/litellm/config.yaml. §11 keeps the proxy so that changing vendor or model is
# a proxy-config change; naming `gpt-4.1` here instead of `chat` moves that decision back into
# the application, and a model the deployment's key cannot reach then fails as a runtime 400
# rather than as a startup error.
MODEL_BLURB=blurb
MODEL_QUERY=query
MODEL_CHAT=chat
MODEL_DOCGEN=docgen

# §11 — OpenAI has no reranker. Self-hosted because it sees the full text of the top-50 chunks,
# the highest-sensitivity payload in the pipeline (§15.7).
#   docker compose -f deploy/docker-compose.yml --profile full up -d reranker
# Leave commented to run RRF-only, which §11 names as the acceptable Phase 1 posture.
# RERANKER_URL=http://localhost:8090
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_TIMEOUT_MS=800

# ── Git provider ──────────────────────────────────────────────────────────────────────────────
# `none` disables webhooks, commit verification and PR creation. Fine for local work.
GIT_PROVIDER=none
# GIT_APP_ID=
# A KMS reference, never key material. This key grants read across every repository in the
# company — the most valuable secret in the engineering estate (§15.7).
# GIT_APP_PRIVATE_KEY_REF=
# Shared secret for git provider webhooks, checked against the raw body before it is parsed.
#
# Unset means webhooks are refused with 501, not accepted unsigned — so push and merged-pull-
# request events do nothing and documentation is never regenerated from them. That is the safe
# default and a confusing one, because nothing else looks wrong: the endpoint answers, the
# provider records a delivery, and no work happens. The API logs `webhooks: disabled` at startup
# so it is visible without reading this file.
#
# Any random string will do locally; in production this is the value configured on the provider
# side and belongs in KMS like every other secret.
GIT_WEBHOOK_SECRET=dev-webhook-secret

# §15.3 — a staging deploy that opens documentation PRs on production repos and assigns them to
# real engineers burns the trust the whole loop depends on. loadPlatformEnv() refuses `true`
# outside production, and the PR client refuses again at the call site.
WRITE_ENABLED=false

# ── Ingest trust boundary (§15.2) ─────────────────────────────────────────────────────────────
INGEST_SIGNATURE_MODE=hmac
INGEST_HMAC_SECRET=  # SET THIS: any value for local use
# OIDC_ISSUER=https://token.actions.githubusercontent.com
OIDC_AUDIENCE=kna-ingest
INGEST_TOKEN_TTL_SECONDS=600
INGEST_MAX_BUNDLE_BYTES=268435456

# ── Auth ──────────────────────────────────────────────────────────────────────────────────────
# SET THIS to any 32+ character string for local use. Production sources it from a secrets
# manager; a shared development value is fine because nothing real is protected by it.
SESSION_SECRET=  # SET THIS: any 32+ character string
JWT_AUDIENCE=kna-platform
MCP_TOKEN_TTL_SECONDS=900
# §15.6 — an explicit revocation SLO. The permission cache TTL is derived from this and is
# always shorter, or the SLO is fiction. Refused above 900.
ACL_REVOCATION_SLO_SECONDS=300

# ── Budgets and breakers ──────────────────────────────────────────────────────────────────────
# §15.3 — the ceiling pauses the queue rather than failing mid-write. Budget exhaustion halfway
# through a repo leaves a partially reindexed corpus, which is worse than never starting.
ORG_DAILY_SPEND_CEILING_USD=500
# The magnitude circuit breaker. A formatter upgrade or a namespace rename flips signatureHash
# on thousands of symbols at once; without this it becomes a cost and PR storm.
CIRCUIT_MAX_CHURN_RATIO=0.25
CIRCUIT_MAX_CHANGED_SYMBOLS=2000
CIRCUIT_MAX_REGENERATIONS=50

# ── Retrieval ─────────────────────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K_DENSE=50
RETRIEVAL_TOP_K_LEXICAL=50
RETRIEVAL_TOP_K_SYMBOL=10
RETRIEVAL_TOP_N_FINAL=8
RETRIEVAL_RRF_K=60
# §15.5 — "that one parameter usually buys more p99 than anything else". Tune it against the
# eval set rather than leaving it at the default.
PGVECTOR_EF_SEARCH=100
# Calibrated against the labelled unanswerable stratum, and model-specific: recalibrate after
# any embedding or reranker change, or you will either refuse answerable questions or answer
# unanswerable ones.
ABSTENTION_THRESHOLD=0.35

# ── Observability ─────────────────────────────────────────────────────────────────────────────
# Optional locally. Required in production, where loadPlatformEnv() refuses to start without the
# OTLP endpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

PORT=8080
MCP_PORT=8081

# ── Your own credentials ───────────────────────────────────────────────────────────────────
# Read by the CLI, not by the services. Optional: `kna ask` and `kna doctor` need KNA_TOKEN, and
# `kna publish` needs an ingest credential, but nothing here starts without them.
#
# `pnpm db:seed` prints these once and stores them hashed, so a lost one is reissued rather than
# recovered. scripts/dev.sh writes them to .kna/tokens.env instead, which is machine-written and
# replaced on every seed — put yours here by hand if you would rather keep it in one file.

# Your identity: who you are, and therefore what you may read.
# KNA_TOKEN=

# Permission to publish one specific repository. Not an identity, and not interchangeable with
# the above. Minted per repo via POST /v1/admin/repos/:repoId/ingest-credential.
# KNA_INGEST_TOKEN=

# Signs bundles on the way out. Must equal INGEST_HMAC_SECRET above — the CLI and the server
# spell the same shared value differently, which is why a publish can silently go out unsigned.
# KNA_INGEST_HMAC_SECRET=
