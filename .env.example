# Platform environment.
#
# `loadPlatformEnv()` validates every entry and refuses several combinations outright — see
# packages/config/src/env.ts. Those refusals are findings from §15, not preferences.

KNA_ENV=development
KNA_REGION=local
LOG_LEVEL=info

# ── Datastores ────────────────────────────────────────────────────────────────────────────────
# Application roles, never the owner. A superuser bypasses row-level security silently, and
# assertRlsEffective() refuses to start against one (migration 0005).
DATABASE_URL=postgres://kna_interactive:devpass@localhost:6432/kna
DATABASE_URL_BATCH=postgres://kna_batch:devpass@localhost:5432/kna
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379

# ── Object storage: the system of record (§15.1 fix 1) ────────────────────────────────────────
BUNDLE_STORE_ENDPOINT=http://localhost:9000
BUNDLE_STORE_BUCKET=kna-ir-bundles
BUNDLE_STORE_ACCESS_KEY=kna
BUNDLE_STORE_SECRET_KEY=knaknakna
BUNDLE_STORE_REGION=us-east-1
AUDIT_STORE_BUCKET=kna-audit

# ── LLM routing ───────────────────────────────────────────────────────────────────────────────
# Always the proxy, never a provider SDK. §11 — three §15 blockers are solved by the proxy
# rather than by application code.
LITELLM_BASE_URL=http://localhost:4000
# Separate virtual keys. A backfill must not 429 the chat path (§15.6).
LITELLM_KEY_INTERACTIVE=sk-kna-interactive
LITELLM_KEY_BATCH=sk-kna-batch

EMBEDDING_MODEL=text-embedding-3-large
# §11 dimension trap: pgvector's HNSW index caps at 2,000 for `vector`, and this model is 3,072
# native. These models are Matryoshka-trained, so truncation is graceful and halves index RAM.
EMBEDDING_DIMENSIONS=1536

MODEL_BLURB=gpt-4.1-mini
MODEL_QUERY=gpt-4.1-mini
MODEL_CHAT=gpt-4.1
MODEL_DOCGEN=gpt-5

# §11 — OpenAI has no reranker. Self-hosted, because the reranker sees the full text of the
# top-50 chunks: the highest-sensitivity payload in the pipeline (§15.7).
# Leave unset to run RRF-only, which §11 names as the acceptable Phase 1 posture.
# RERANKER_URL=http://localhost:8090
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_TIMEOUT_MS=800

# ── Git provider ──────────────────────────────────────────────────────────────────────────────
GIT_PROVIDER=none
# GIT_APP_ID=123456
# A KMS reference, never key material. This key grants read across every repository in the
# company — the most valuable secret in the engineering estate (§15.7).
# GIT_APP_PRIVATE_KEY_REF=arn:aws:kms:eu-west-1:...:key/...
# GIT_WEBHOOK_SECRET=

# §15.3 — a staging deploy that opens documentation PRs on production repos and assigns them to
# real engineers burns exactly the trust the doc-PR loop depends on. The env loader refuses
# true outside production.
WRITE_ENABLED=false

# ── Ingest trust boundary (§15.2) ─────────────────────────────────────────────────────────────
INGEST_SIGNATURE_MODE=hmac
INGEST_HMAC_SECRET=development-ingest-secret
# OIDC_ISSUER=https://token.actions.githubusercontent.com
OIDC_AUDIENCE=kna-ingest
INGEST_TOKEN_TTL_SECONDS=600
INGEST_MAX_BUNDLE_BYTES=268435456

# ── Auth ──────────────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=development-session-secret-at-least-32-chars
JWT_AUDIENCE=kna-platform
MCP_TOKEN_TTL_SECONDS=900
# §15.6 — an explicit revocation SLO. The permission cache TTL is derived from this and must be
# shorter, or the SLO is fiction.
ACL_REVOCATION_SLO_SECONDS=300

# ── Budgets and breakers ──────────────────────────────────────────────────────────────────────
# §15.3 — pauses the queue rather than failing mid-write. Budget exhaustion halfway through a
# repo leaves a partially reindexed corpus, which is worse than never starting.
ORG_DAILY_SPEND_CEILING_USD=500
CIRCUIT_MAX_CHURN_RATIO=0.25
CIRCUIT_MAX_CHANGED_SYMBOLS=2000
CIRCUIT_MAX_REGENERATIONS=50

# ── Retrieval ─────────────────────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K_DENSE=50
RETRIEVAL_TOP_K_LEXICAL=50
RETRIEVAL_TOP_K_SYMBOL=10
RETRIEVAL_TOP_N_FINAL=8
RETRIEVAL_RRF_K=60
# §15.5 — "that one parameter usually buys more p99 than anything else". Tune against the eval
# set rather than leaving it at the default.
PGVECTOR_EF_SEARCH=100
# Calibrated against the labelled unanswerable stratum. Model-specific: recalibrate after any
# embedding or reranker change.
ABSTENTION_THRESHOLD=0.35

# ── Observability ─────────────────────────────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

PORT=8080
MCP_PORT=8081
